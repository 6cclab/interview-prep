{
  "name": "interview-prep",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:harness": "vitest run voice scripts test-utils",
    "test:watch": "vitest",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "reset": "tsx scripts/reset.ts",
    "drill": "tsx scripts/drill.ts",
    "domains": "tsx scripts/domains-cli.ts",
    "exercises": "tsx scripts/check-exercises.ts",
    "ingest": "tsx scripts/ingest.ts",
    "migrate-local": "tsx scripts/migrate-local.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p voice/web/tsconfig.json",
    "mock:voice": "tsx voice/cli.ts mock",
    "build:web": "vite build --config voice/web/vite.config.ts",
    "dev:web": "vite --config voice/web/vite.config.ts",
    "dev:web:api": "tsx voice/http-server.ts",
    "mock:web": "pnpm run build:web && tsx voice/http-server.ts",
    "mock:web:vague": "VOICE_VAGUE=1 pnpm run mock:web",
    "mock:web:claude": "VOICE_BACKEND=cli VOICE_BACKEND_MOCK= VOICE_BACKEND_DESIGN= VOICE_BACKEND_CODING= VOICE_BACKEND_COACH= VOICE_BACKEND_ASSISTED= VOICE_BACKEND_DEBUG= VOICE_BACKEND_PRACTICE= pnpm run mock:web",
    "mock:web:openai": "VOICE_BACKEND=openai VOICE_BACKEND_MOCK= VOICE_BACKEND_DESIGN= VOICE_BACKEND_CODING= VOICE_BACKEND_COACH= VOICE_BACKEND_ASSISTED= VOICE_BACKEND_DEBUG= VOICE_BACKEND_PRACTICE= pnpm run mock:web",
    "mock:web:ollama": "VOICE_BACKEND=ollama VOICE_BACKEND_MOCK= VOICE_BACKEND_DESIGN= VOICE_BACKEND_CODING= VOICE_BACKEND_COACH= VOICE_BACKEND_ASSISTED= VOICE_BACKEND_DEBUG= VOICE_BACKEND_PRACTICE= pnpm run mock:web",
    "mock:web:hybrid": "VOICE_BACKEND=cli VOICE_BACKEND_MOCK=ollama VOICE_BACKEND_DESIGN= VOICE_BACKEND_CODING= VOICE_BACKEND_COACH= VOICE_BACKEND_ASSISTED= VOICE_BACKEND_DEBUG= VOICE_BACKEND_PRACTICE= pnpm run mock:web",
    "design:voice": "tsx voice/cli.ts design",
    "voice:devices": "tsx voice/cli.ts devices",
    "voice:voices": "tsx voice/cli.ts voices",
    "voice:live": "tsx voice/cli.ts live",
    "voice:debrief": "tsx voice/cli.ts debrief"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.19.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.1",
    "brutalkit": "^0.4.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0"
  }
}
