# Copy to deploy/.env and fill in. Nothing here has a default that would let a
# misconfigured deployment start and look like it worked.

# Postgres. Any strong value; it never leaves this machine unless you publish
# the port, which the compose file does not.
POSTGRES_PASSWORD=

# Signs session cookies. Generate one and keep it: changing it signs everyone
# out, and losing it means nobody can be signed in again.
#   openssl rand -base64 48
AUTH_SECRET=

# The origin a browser actually types. Cookies are scoped to it and Better Auth
# checks state-changing requests against it, so a mismatch reads as sign-up
# silently failing.
AUTH_BASE_URL=http://127.0.0.1:4173

# The interviewer transport. One of: ollama, openai, api, cli. There is no
# default — see voice/backend.ts for why.
VOICE_BACKEND=ollama

# Whichever the chosen backend needs.
OLLAMA_HOST=
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Host port to publish the app on.
PORT=4173
